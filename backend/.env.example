# Andon Assistant - backend config. Copy this file to ".env" and fill in your key.
# The browser dashboard uses keys you paste in its "Keys" panel; this .env is for
# the terminal agent (python -m app.cli) and for local defaults.

APP_PROVIDER=anthropic
APP_MODEL=claude-sonnet-5-5
APP_CORS_ORIGINS=*

# Your API key for the provider above (bring your own - never commit the real .env):
#   Anthropic: https://console.anthropic.com/settings/keys   (needs API credit on the account)
#   OpenAI:    https://platform.openai.com/api-keys
#   Kimi:      https://platform.moonshot.ai/console/api-keys
APP_API_KEY=

# --- Optional: review new memories before they are saved ---
# When on, facts the assistant picks up on its own wait in ~/.assistant/memory/candidates/
# for you to approve (dashboard memory panel, /review in the terminal, or edit the file).
# APP_MEMORY_REVIEW=1
# APP_MEMORY_DIR=C:\path\to\memory

# --- Optional: where research run folders go (plan.md, evidence.md, report.md per run) ---
# Default: ~/.assistant/runs
# APP_RUNS_DIR=C:\path\to\runs

# --- Optional: Google Calendar sync (two-way) ---
# Run scripts/google_auth.py once to create token.json, then:
# APP_GOOGLE_CALENDAR=1
# APP_GOOGLE_TOKEN_FILE=C:\path\to\token.json

# --- Optional: Outlook / Microsoft 365 sync (two-way) ---
# Register an Entra app, run scripts/outlook_auth.py once, then:
# APP_OUTLOOK_CALENDAR=1
# APP_OUTLOOK_CLIENT_ID=your-entra-app-client-id
# APP_OUTLOOK_TENANT=common
# APP_OUTLOOK_TOKEN_CACHE=C:\path\to\outlook_token.json

# Timezone used when creating cloud events, and how often to pull (minutes):
# APP_CALENDAR_TIMEZONE=UTC
# APP_CALENDAR_SYNC_MINUTES=15
